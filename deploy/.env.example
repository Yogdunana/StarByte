# ─────────────────────────────────────────────────────────
# StarByte 环境变量模板
#
# 【不要直接 cp 成 .env 手填】
# 密钥类键在下面全部留空，由安装时的随机生成流程写入：
#
#     sudo starbyte install      # 首次安装，自动生成并将口令当场告知
#     starbyte init              # 只做密钥生成 / 首次生成 .env
#     starbyte init --force      # 为已有部署重新生成密钥（保留其余键值）
#     starbyte credentials       # 忘记口令时从 deploy/.env 再读一次
#
# 生成后口令保存在 deploy/.env，并在安装终端打印**一次**（不落任何凭证文件）。
# 忘记口令就在可信终端重新执行 `starbyte credentials`。
# Windows 上 0600 权限位不生效，务必确保 deploy/.env 不被提交。
#
# 用 <...> 包裹的值是拓扑占位符：starbyte init 不会把它们写进 .env，
# 对应项由 docker-compose.yml 里的 `${VAR:-默认}` 兜底（见该文件注释）。
# 真实内网地址请只写在运维本机的 deploy/.env，不要提交回仓库。
# ─────────────────────────────────────────────────────────

# 数据库配置（密码由 starbyte init 生成）
POSTGRES_USER=starbyte
POSTGRES_PASSWORD=
POSTGRES_DB=starbyte

# Redis 配置（密码由 starbyte init 生成）
REDIS_PASSWORD=

# MinIO 配置（账号与密码均由 starbyte init 生成，默认不再是 minioadmin）
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# 镜像 tag。默认 latest + compose pull_policy: if_not_present，
# 本机已有兼容镜像时不会去拉钉死的 RELEASE tag（校园镜像站常对 RELEASE.* 返回 403）。
# 需要可复现构建时钉版本或 digest：MINIO_IMAGE=minio/minio:RELEASE.2024-08-17T01-16-21Z
MINIO_IMAGE=minio/minio:latest

# JWT 配置（由 starbyte init 生成 64 位随机串；长度 <32 或命中占位词表会被后端拒绝启动）
JWT_SECRET=

# 是否跳过数据库自动迁移（默认 false）
SKIP_MIGRATION=false

# 数据库迁移失败是否退出容器（生产环境建议 true）
MIGRATION_FAIL_FATAL=true

# 是否跳过 MinIO Bucket 自动创建。
# 校园网 / 内网默认 true：后端镜像内 mc 为占位脚本（不从 dl.min.io 下载），
# 入口脚本不会调用真实 mc。请在 MinIO 控制台手动创建一次 starbyte 桶。
SKIP_BUCKET_CREATE=true

# ─────────────────────────────────────────────────────────
# 校园网 / 内网 Docker 构建说明
# ─────────────────────────────────────────────────────────
# 后端 Dockerfile 已默认：goproxy.cn 拉模块并 go install golang-migrate v4.17.0、
# mc 占位（配合上面的 SKIP_BUCKET_CREATE=true）。
# postgres / redis / 前端仍用 docker.io 官方 tag：
#   postgres:16-alpine、redis:7-alpine、node:22-alpine、nginx:1.27-alpine
# 不要在 compose / Dockerfile 写死未验证的华为 SWR / 镜像站地址。
# 拉基础镜像：在 daemon.json 配置 registry-mirrors（见 docs/deployment.md），
# 或在可联网机器 pull 后 docker tag / save 导入。镜像站会 403，先自测再依赖。

# 学校 CAS：学校已把 starbyte.smbu.edu.cn 解析到内网，HTTPS 由学校那层终止。
# CAS 侧的 service / 邮件链接都必须用域名，不能用内网 IP ——
# 校园网网关按 Referer 的 host 做来源白名单，只认 *.smbu.edu.cn。
CAS_ENABLED=true
CAS_SERVER_URL=https://authserver.smbu.edu.cn/authserver
CAS_SERVICE_URL=
# 对外入口地址。留空 / 占位符时由 compose 默认值（https://starbyte.smbu.edu.cn）兜底。
CAS_FRONTEND_URL=<对外入口地址，如 https://starbyte.smbu.edu.cn>
# 能通过 CAS 认证但系统内无账号时的处理：默认不再自动开户。
# 需要批量放行时由运维显式改为 true。
CAS_ALLOW_AUTO_PROVISION=false
CAS_DEFAULT_ROLE=user

# 备份（#88）：产物默认写入已有 MinIO 桶 + backups/ 前缀。可选本地回退。
# 不要把数据库 / MinIO 密码写进 YAML；沿用上面的 POSTGRES_* / MINIO_*。
# STARBYTE_BACKUP_BUCKET=
# STARBYTE_BACKUP_PREFIX=backups
# STARBYTE_BACKUP_LOCAL_PATH=
# STARBYTE_BACKUP_ENCRYPTION_KEY=

# SMTP 密码（只放本机 deploy/.env，不要提交真实值；由 starbyte init 生成加密密钥）
# 非密钥项（host/port/发件人）可在系统配置页改，默认腾讯企业邮 465 隐式 SSL。
STARBYTE_SMTP_PASSWORD=
# 容器 extra_hosts：把 authserver.smbu.edu.cn 指到校园网 IPv4。
# 不设则 compose 用其内置默认值。缺此项时容器可能解析到公网 IPv6，
# CAS callback 卡住 / nginx 502，真实 IP 请只写在运维本机 .env。
CAS_AUTHSERVER_IP=<CAS 服务器内网 IPv4>

# Client IP: frontend's address on the dedicated proxy network only.
# If this subnet conflicts with an existing network, change all four together.
# 占位符留空时由 compose 默认值（172.30.77.0/29）兜底。
#
# 注意：<...> 必须**包住整个值**（以 < 开头、以 > 结尾），starbyte init 才会把它
# 当作占位符注释掉。曾经写成 `TRUSTED_PROXIES=<反代容器 IP>/32`（结尾是 /32 不是 >），
# 于是整行被原样写进 .env，后端启动时解析 CIDR 失败直接退出、容器反复重启。
# env-check 现在会校验该值的格式，但模板本身也别再写成半截占位符。
STARBYTE_PROXY_SUBNET=<未与现有网段冲突的私网 /29 网段>
STARBYTE_FRONTEND_PROXY_IP=<反代容器在该网段的地址>
STARBYTE_BACKEND_PROXY_IP=<后端容器在该网段的地址>
TRUSTED_PROXIES=<反代容器 IP 段，如 172.30.77.2/32>

# 保存系统配置页里的 SMTP 密码所用的加密密钥。
# 由 starbyte init 自动生成（Base64 编码的 32 字节；后端按 base64.StdEncoding 解码校验）。
# 务必与 deploy/.env 一起备份，丢失后已存密码无法解密。
STARBYTE_CONFIG_ENCRYPTION_KEY=

# 备份产物（pg_dump）的 AES-256 加密密钥。
# 由 starbyte init 自动生成（Base64 编码的 32 字节）。留空则备份不加密。
STARBYTE_BACKUP_ENCRYPTION_KEY=

# /metrics 访问令牌。留空则生产环境直接返回 404（不暴露端点）。
# 需要 Prometheus 抓取时由 starbyte init 之外显式设置一个随机串。
# METRICS_TOKEN=
