# ─────────────────────────────────────────────────────────
# StarByte 环境变量示例
# 复制为 .env 并根据实际情况修改
# ─────────────────────────────────────────────────────────

# 数据库配置
POSTGRES_USER=starbyte
POSTGRES_PASSWORD=starbyte123
POSTGRES_DB=starbyte

# Redis 配置
REDIS_PASSWORD=starbyte123

# MinIO 配置
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# 镜像 tag。默认 latest + compose pull_policy: if_not_present，
# 本机已有兼容镜像时不会去拉钉死的 RELEASE tag（校园镜像站常对 RELEASE.* 返回 403）。
# 需要钉版本：MINIO_IMAGE=minio/minio:RELEASE.2024-08-17T01-16-21Z
MINIO_IMAGE=minio/minio:latest

# JWT 配置（生产环境务必修改为复杂随机字符串）
JWT_SECRET=your-super-secret-key-change-in-production-please

# 是否跳过数据库自动迁移（默认 false）
SKIP_MIGRATION=false

# 数据库迁移失败是否退出容器（生产环境建议 true）
MIGRATION_FAIL_FATAL=true

# 是否跳过 MinIO Bucket 自动创建。
# 校园网 / 内网默认 true：后端镜像内 mc 为占位脚本（不从 dl.min.io 下载），
# 入口脚本不会调用真实 mc。请在 MinIO 控制台手动创建一次 starbyte 桶。
SKIP_BUCKET_CREATE=true

# ─────────────────────────────────────────────────────────
# 校园网 / 内网 Docker 构建说明
# ─────────────────────────────────────────────────────────
# 后端 Dockerfile 已默认：ghfast.top 拉 golang-migrate v4.17.0、
# GOPROXY=goproxy.cn、mc 占位（配合上面的 SKIP_BUCKET_CREATE=true）。
# postgres / redis / 前端仍用 docker.io 官方 tag：
#   postgres:16-alpine、redis:7-alpine、node:20-alpine、nginx:1.27-alpine
# 不要在 compose / Dockerfile 写死未验证的华为 SWR / 镜像站地址。
# 拉基础镜像：在 daemon.json 配置 registry-mirrors（见 docs/deployment.md），
# 或在可联网机器 pull 后 docker tag / save 导入。镜像站会 403，先自测再依赖。

# 学校 CAS（漏测先用校园网 IP，回调按访问地址自动拼）
CAS_ENABLED=true
CAS_SERVER_URL=https://authserver.smbu.edu.cn/authserver
CAS_SERVICE_URL=
CAS_FRONTEND_URL=
CAS_ALLOW_AUTO_PROVISION=true
CAS_DEFAULT_ROLE=member

# 备份（#88）：产物默认写入已有 MinIO 桶 + backups/ 前缀。可选本地回退。
# 不要把数据库 / MinIO 密码写进 YAML；沿用上面的 POSTGRES_* / MINIO_*。
# STARBYTE_BACKUP_BUCKET=
# STARBYTE_BACKUP_PREFIX=backups
# STARBYTE_BACKUP_LOCAL_PATH=
# STARBYTE_BACKUP_ENCRYPTION_KEY=

# SMTP 密码（只放本机 / 10.100.13.17 的 deploy/.env，不要提交真实值）
# 非密钥项（host/port/发件人）可在系统配置页改，默认腾讯企业邮 465 隐式 SSL。
STARBYTE_SMTP_PASSWORD=
# 容器 extra_hosts：把 authserver.smbu.edu.cn 指到校园网 IPv4。
# 默认 10.100.14.250（深北莫信息化内网）。不设则 compose 也用该默认。
# 缺此项时容器可能解析到公网 IPv6，CAS callback 卡住 / nginx 502。
CAS_AUTHSERVER_IP=10.100.14.250

# Client IP: frontend's address on the dedicated proxy network only.
# If this subnet conflicts with an existing network, change all four together.
STARBYTE_PROXY_SUBNET=172.30.77.0/29
STARBYTE_FRONTEND_PROXY_IP=172.30.77.2
STARBYTE_BACKEND_PROXY_IP=172.30.77.3
TRUSTED_PROXIES=172.30.77.2/32
