#!/usr/bin/env bash
# StarByte 应急运维 CLI（类似宝塔 bt）
# 依赖：bash + docker compose。
#
# 密钥显示策略：
#   - status / logs / doctor / env-check / backup 等日常命令一律不打印 .env 密钥值；
#   - 只有 starbyte init 与 starbyte credentials 会显示口令。这两个命令是
#     「安装期由系统自动随机生成口令，并把结果告知运维」的唯一通道。
set -euo pipefail

VERSION="1.1.0"
CONF_FILE="/etc/starbyte.conf"

usage() {
  cat <<'EOF'
StarByte 应急运维 CLI（类似宝塔 bt）

用法:
  starbyte <命令> [参数]
  sb <命令> [参数]          # 安装后的短命令

命令:
  init [--force]                 由系统自动生成随机密钥并写出 deploy/.env
                                 首次安装必须执行；生成后会把口令告知运维
  credentials                    再次显示系统生成的口令（仅限可信终端）
  status                         compose ps + :8080 / :80 短健康检查
  logs [服务] [--tail N]         查看日志（默认 --tail 100）
  restart [服务|all]             重启容器，不重建镜像
  rebuild [backend|frontend|all] 构建并 --no-deps 重建应用（不强拉 MinIO/Postgres）
  env-check                      检查 deploy/.env 关键键名（不打印值）
  backup [create|list|preview|restore|drill|emergency]
                                 托管备份（与应用同一套 gzip/AES/预览/告警）
                                 emergency 才走主机明文 pg_dump
  doctor                         校园网部署常见问题排查
  ssl <子命令>                   HTTPS 开关（审计项 S-03）
                                 status / enable / verify / disable / selfsign
                                 一期接学校通配证书只需 enable --cert --key
  install                        安装到 /usr/local/bin/starbyte，并创建 sb 软链
                                 若 deploy/.env 不存在会自动执行 init
  help                           显示本帮助
  version                        显示版本

环境:
  STARBYTE_HOME    仓库根目录（含 deploy/docker-compose.yml）
  /etc/starbyte.conf  可写 STARBYTE_HOME=/path

示例:
  sudo starbyte install          # 安装 CLI，首次会自动生成随机口令
  starbyte init --force          # 为已有部署重新生成全部密钥
  starbyte credentials           # 忘记口令时再查一次
  starbyte status
  starbyte logs backend --tail 200
  starbyte rebuild all
  starbyte doctor
  starbyte ssl enable --cert /root/smbu.crt --key /root/smbu.key
  starbyte ssl status
  starbyte ssl disable
EOF
}

log() { printf '%s\n' "$*"; }
err() { printf '错误: %s\n' "$*" >&2; }
ok() { printf '  [OK] %s\n' "$*"; }
warn() { printf '  [!!] %s\n' "$*"; }
info() { printf '  [--] %s\n' "$*"; }

# 只读 STARBYTE_HOME=...，忽略其它行，避免误 source 含命令的文件
load_conf() {
  if [[ ! -f "$CONF_FILE" ]]; then
    return 0
  fi
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line#"${line%%[![:space:]]*}"}"
    line="${line%"${line##*[![:space:]]}"}"
    [[ -z "$line" ]] && continue
    key="${line%%=*}"
    val="${line#*=}"
    if [[ "$key" == "STARBYTE_HOME" && -n "$val" ]]; then
      STARBYTE_HOME="$val"
    fi
  done < "$CONF_FILE"
}

resolve_script_path() {
  local src="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    src="$(readlink -f "$src" 2>/dev/null || printf '%s' "$src")"
  fi
  printf '%s' "$src"
}

find_root() {
  local candidate
  if [[ -n "${STARBYTE_HOME:-}" ]]; then
    candidate="${STARBYTE_HOME}"
    if [[ -f "$candidate/deploy/docker-compose.yml" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
  fi

  load_conf
  if [[ -n "${STARBYTE_HOME:-}" && -f "${STARBYTE_HOME}/deploy/docker-compose.yml" ]]; then
    printf '%s' "$STARBYTE_HOME"
    return 0
  fi

  local here
  here="$(cd "$(dirname "$(resolve_script_path)")" && pwd)"
  if [[ -f "$here/../../deploy/docker-compose.yml" ]]; then
    (cd "$here/../.." && pwd)
    return 0
  fi

  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    if [[ -f "$d/deploy/docker-compose.yml" ]]; then
      printf '%s' "$d"
      return 0
    fi
    d="$(dirname "$d")"
  done

  err "未找到 StarByte 仓库根（deploy/docker-compose.yml）。"
  err "请在仓库目录执行，或设置 STARBYTE_HOME，或运行: sudo starbyte install"
  exit 1
}

need_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    err "未找到 docker"
    exit 1
  fi
  if ! docker compose version >/dev/null 2>&1; then
    err "未找到 docker compose 插件"
    exit 1
  fi
}

ROOT=""
init_root() {
  ROOT="$(find_root)"
}

compose() {
  local args=(-f "$ROOT/deploy/docker-compose.yml")
  # HTTPS 启用时自动叠加 override。启用状态的唯一事实来源是 https.d 里那个
  # 生成出来的 conf —— 由 starbyte ssl enable / disable 写入与移除。
  # 不启用时不叠加：否则宿主 443 被占用会让最普通的 `docker compose up` 直接失败。
  if https_enabled; then
    args+=(-f "$ROOT/deploy/docker-compose.https.yml")
  fi
  if [[ -f "$ROOT/deploy/.env" ]]; then
    args+=(--env-file "$ROOT/deploy/.env")
  fi
  docker compose "${args[@]}" "$@"
}

# 从 .env 取键值到变量，不向终端打印。
# 与 compose env-file 一致：后者覆盖前者；去掉行尾 CR 与成对包裹引号。
env_get() {
  local key="$1"
  local file="$ROOT/deploy/.env"
  local line="" val=""
  [[ -f "$file" ]] || return 1
  line="$(grep -E "^${key}=" "$file" | tail -n1 || true)"
  [[ -n "$line" ]] || return 1
  val="${line#*=}"
  val="${val%$'\r'}"
  if [[ ${#val} -ge 2 ]]; then
    case "$val" in
      \"*\") val="${val:1:${#val}-2}" ;;
      \'*\') val="${val:1:${#val}-2}" ;;
    esac
  fi
  printf '%s' "$val"
}

env_has_key() {
  local key="$1"
  local file="$ROOT/deploy/.env"
  [[ -f "$file" ]] && grep -Eq "^${key}=" "$file"
}

# ─────────────────────────────────────────────────────────
# 安装期随机密钥生成（starbyte init）
#
# 产品约束：不让运维自行生成或手填随机值 —— 由本 CLI 在安装时自动生成，
# 并在生成后把结果明确告知运维。
#
# 字符集只用 [A-Za-z0-9]，刻意不用 base64 的 +/= 与 shell 元字符：
#   - 口令会进入 DATABASE_URL、redis-server --requirepass、compose 插值；
#   - 任何 & ? # @ / : " ' \ 都可能被 DSN 解析或 shell 二次解释吃掉。
# 32 位 alnum ≈ 190 bit 熵，足够。
# ─────────────────────────────────────────────────────────

ENV_REL="deploy/.env"
ENV_EXAMPLE_REL="deploy/.env.example"
CRED_REL="deploy/.env.credentials"

# "键名:生成方式:参数"，顺序决定打印顺序。
#   alnum:<字符数>  —— 口令类，字符集限定 [A-Za-z0-9]。
#   b64:<字节数>    —— 需要 Base64 形态的密钥，输出保留标准 base64 字符集（含 + / =）。
#
# 为什么分两种：STARBYTE_CONFIG_ENCRYPTION_KEY 被后端按
# `base64.StdEncoding.DecodeString` 解码后要求恰好 32 字节
# （backend/pkg/config/smtp_secret.go:14）。若像口令那样把非字母数字字符过滤掉，
# 44 个字母数字会被解码成 33 字节，后端必然报错——生成器与消费者就对不上了。
SECRET_SPECS=(
  "POSTGRES_PASSWORD:alnum:32"
  "REDIS_PASSWORD:alnum:32"
  "MINIO_ROOT_USER:alnum:12"
  "MINIO_ROOT_PASSWORD:alnum:32"
  "JWT_SECRET:alnum:64"
  "STARBYTE_CONFIG_ENCRYPTION_KEY:b64:32"
  "STARBYTE_BACKUP_ENCRYPTION_KEY:b64:32"
)

# 口令类：只用 [A-Za-z0-9]。值会写入 .env 并被 compose 插值，
# 含 $ / 反引号 / 引号会直接破坏部署，故刻意剔除这些字符。
gen_alnum_secret() {
  local n="${1:-32}" raw=""
  # 首选 openssl（若存在），失败或长度不足再退到 /dev/urandom。
  if command -v openssl >/dev/null 2>&1; then
    raw="$(openssl rand -base64 $((n * 2)) 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-"$n" || true)"
  fi
  if [[ "${#raw}" -lt "$n" ]]; then
    # cut 会读完整个输入，不会因 head 提前关闭管道触发 SIGPIPE（set -o pipefail 下会失败）。
    raw="$(dd if=/dev/urandom bs=256 count=1 2>/dev/null | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-"$n" || true)"
  fi
  if [[ "${#raw}" -lt "$n" ]]; then
    err "无法生成随机值：openssl 与 /dev/urandom 均不可用。"
    err "本机需要可用的随机源；不要改用手工填值。"
    exit 1
  fi
  printf '%s' "$raw"
}

# Base64 类：输出标准 base64，只去掉换行，保留 + / =。
# 值写入 .env 是安全的：+/= 在 .env 里都是普通字符，不会被 compose 展开。
gen_b64_secret() {
  local bytes="${1:-32}" raw=""
  if command -v openssl >/dev/null 2>&1; then
    raw="$(openssl rand -base64 "$bytes" 2>/dev/null | tr -d '\r\n' || true)"
  fi
  if [[ -z "$raw" ]] && command -v base64 >/dev/null 2>&1; then
    raw="$(dd if=/dev/urandom bs="$bytes" count=1 2>/dev/null | base64 | tr -d '\r\n' || true)"
  fi
  if [[ -z "$raw" ]]; then
    err "无法生成 Base64 密钥：本机既没有 openssl 也没有 base64。"
    exit 1
  fi
  printf '%s' "$raw"
}

# 按 SECRET_SPECS 的生成方式分派。
gen_secret() {
  local mode="${1:-alnum}" param="${2:-32}"
  case "$mode" in
    b64) gen_b64_secret "$param" ;;
    *)   gen_alnum_secret "$param" ;;
  esac
}

# 校验某个值是否为「Base64 解码后恰好 bytes 字节」——即后端能接受它的充分条件。
# 没有 base64 命令时退化为长度启发式（编码长度按 4 字节对齐，含填充）。
b64_decodes_to() {
  local val="$1" bytes="$2" n="" expected
  if command -v base64 >/dev/null 2>&1; then
    n="$(printf '%s' "$val" | base64 -d 2>/dev/null | wc -c | tr -d '[:space:]')"
    [[ "$n" == "$bytes" ]]
    return
  fi
  expected=$(( (bytes + 2) / 3 * 4 ))
  [[ "${#val}" -eq "$expected" ]]
}

# 保持 .env.example 的键顺序与注释，只替换/追加密钥键的值。
write_env_value() {
  local file="$1" key="$2" val="$3" tmp
  umask 077
  tmp="$(mktemp)"
  if grep -Eq "^${key}=" "$file"; then
    awk -v k="$key" -v v="$val" 'index($0, k"=") == 1 { print k"="v; next } { print }' "$file" > "$tmp"
  else
    cat "$file" > "$tmp"
    printf '%s=%s\n' "$key" "$val" >> "$tmp"
  fi
  cat "$tmp" > "$file"
  rm -f "$tmp"
}

# .env.example 里用 `<...>` 包裹的拓扑占位符不写进 .env，
# 让 compose 里带默认值的项（CAS_AUTHSERVER_IP / CAS_FRONTEND_URL / 代理网段）自己兜底。
neutralize_placeholders() {
  local file="$1" tmp
  umask 077
  tmp="$(mktemp)"
  awk '
    /^[[:space:]]*#/ { print; next }
    /^[A-Za-z_][A-Za-z0-9_]*=/ {
      eq = index($0, "="); v = substr($0, eq + 1)
      if (v ~ /^<.*>$/) { print "# " $0 "   # 占位符未填，已忽略（compose 默认值生效）"; next }
    }
    { print }
  ' "$file" > "$tmp"
  cat "$tmp" > "$file"
  rm -f "$tmp"
}

print_credentials() {
  local f="$1" mode="${2:-initial}"
  printf '\n'
  printf '================================================================\n'
  if [[ "$mode" == "initial" ]]; then
    printf ' StarByte 初始口令（系统自动随机生成，仅此一次展示）\n'
  else
    printf ' StarByte 当前口令（由 deploy/.env 读出）\n'
  fi
  printf '================================================================\n'
  cat "$f"
  printf '================================================================\n'
  if [[ "$mode" == "initial" ]]; then
    printf ' 请立即抄录 / 存入密码管理器，然后删除该文件：\n'
    printf '   shred -u %s   (或 rm -f)\n' "$f"
    printf ' 之后仍可用 starbyte credentials 从 deploy/.env 重新读出。\n'
  fi
  printf '================================================================\n'
}

cmd_init() {
  local force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1; shift ;;
      -h|--help)
        log "用法: starbyte init [--force]"
        log "  无参数：deploy/.env 不存在时按模板生成随机密钥；已存在则不动。"
        log "  --force：对已存在的 .env 只重新生成密钥项，其余键值保留。"
        return 0
        ;;
      *) err "未知参数: $1"; exit 2 ;;
    esac
  done
  init_root

  local example="$ROOT/$ENV_EXAMPLE_REL"
  local envf="$ROOT/$ENV_REL"
  local credf="$ROOT/$CRED_REL"

  if [[ ! -f "$example" ]]; then
    err "缺少模板 $example，无法生成配置"
    exit 1
  fi

  local fresh=1
  if [[ -f "$envf" ]]; then
    if [[ "$force" -eq 0 ]]; then
      log "已存在 $envf，未做任何修改。"
      log "  重新生成密钥: starbyte init --force"
      log "  查看初始口令: starbyte credentials"
      return 0
    fi
    log "已存在 $envf：--force 会替换全部密钥项，非密钥键（库名/用户名/拓扑）保持不变。"
    log "  注意：换掉 POSTGRES_PASSWORD / REDIS_PASSWORD / MINIO_ROOT_PASSWORD 后，"
    log "        已初始化的数据卷仍用旧口令，需要同步改库/缓存/对象存储的口令，"
    log "        或者清空卷重来（会丢数据）。生产上更稳妥的做法是重新走一次全新部署。"
    fresh=0
  fi

  if [[ "$fresh" -eq 1 ]]; then
    umask 077
    cp "$example" "$envf"
    neutralize_placeholders "$envf"
    log "已按 $ENV_EXAMPLE_REL 生成 $ENV_REL"
  fi
  chmod 600 "$envf" 2>/dev/null || true

  local spec key mode param val
  local -a shown=()
  for spec in "${SECRET_SPECS[@]}"; do
    IFS=':' read -r key mode param <<<"$spec"
    # --force 的语义就是「重新生成」：所有密钥项一律换新，不沿用旧值。
    # 非密钥键（POSTGRES_USER / POSTGRES_DB / 拓扑项等）保持不动。
    val="$(gen_secret "$mode" "$param")"
    write_env_value "$envf" "$key" "$val"
    shown+=("$key=$val")
  done

  # 生成后立刻自检，避免写出一个 compose 或后端会拒绝的 .env
  local bad=0
  for spec in "${SECRET_SPECS[@]}"; do
    IFS=':' read -r key mode param <<<"$spec"
    val="$(env_get "$key" || true)"
    if [[ -z "$val" ]]; then
      err "生成后仍为空: $key"
      bad=$((bad + 1))
      continue
    fi
    # b64 类必须真能被后端解码成 param 字节，光看「非空」会漏掉格式不对的情况。
    if [[ "$mode" == "b64" ]] && ! b64_decodes_to "$val" "$param"; then
      err "生成的密钥格式不正确（Base64 解码后应为 ${param} 字节）: $key"
      bad=$((bad + 1))
    fi
  done
  if [[ "$bad" -gt 0 ]]; then
    err "密钥生成不完整，已中止。请检查 $envf 的写权限。"
    exit 1
  fi

  # 整份 .env 只让属主可读（内含 Postgres / Redis / MinIO / JWT 明文）。
  # Windows 上 chmod 基本无效（Git Bash 仍显示 644），属平台限制；
  # 真正的保护靠不要提交（deploy/.gitignore 已含 .env 与 .env.credentials）。
  umask 077
  chmod 600 "$envf" 2>/dev/null || true

  umask 077
  : > "$credf"
  chmod 600 "$credf" 2>/dev/null || true

  # 唯一一次明文展示：直接从内存里的 .env 读出，不落盘。
  print_credentials_copy

  # 展示完之后，credf 只留「去哪儿再读」的提示，不再存明文口令。
  {
    printf '# StarByte 密钥已生成完毕（明文口令已在安装终端展示过一次）。\n'
    printf '# 需要再次查看请运行：starbyte credentials\n'
    printf '#\n'
    printf '# 容器内使用的连接信息（供接入方参考，勿外传）：\n'
    printf '#   PostgreSQL  主机 postgres  端口 5432  库/用户见 deploy/.env\n'
    printf '#   Redis       主机 redis     端口 6379\n'
    printf '#   MinIO       主机 minio     端口 9000\n'
  } > "$credf"
  chmod 600 "$credf" 2>/dev/null || true

  log "已写入: $envf （密钥项，权限 0600）"
  log "已写入: $credf （仅提示，不含明文）"
  log ""
  log "下一步: starbyte env-check && docker compose --env-file $ENV_REL -f deploy/docker-compose.yml up -d"
}

# 把刚生成的密钥打印到终端——明文口令在整个流程里只在这一次出现。
# 与 cmd_credentials 的区别：数据取自内存（env_get），不经过磁盘。
print_credentials_copy() {
  local spec key
  printf '\n'
  printf '================================================================\n'
  printf ' StarByte 初始口令（系统自动随机生成，仅此一次展示）\n'
  printf ' 请立即抄录或存入密码管理器。该列表不会落盘。\n'
  printf '================================================================\n'
  for spec in "${SECRET_SPECS[@]}"; do
    key="${spec%%:*}"
    printf '%s=%s\n' "$key" "$(env_get "$key" || true)"
  done
  printf '================================================================\n'
  printf ' 之后可随时用 `starbyte credentials` 从 deploy/.env 重新读出。\n'
  printf '================================================================\n'
}

cmd_credentials() {
  init_root
  local envf="$ROOT/$ENV_REL"
  if [[ ! -f "$envf" ]]; then
    err "未找到 $envf。请先执行: starbyte init"
    exit 1
  fi
  local spec key val tmp
  umask 077
  tmp="$(mktemp)"
  chmod 600 "$tmp"
  for spec in "${SECRET_SPECS[@]}"; do
    key="${spec%%:*}"
    val="$(env_get "$key" || true)"
    if [[ -n "$val" ]]; then
      printf '%s=%s\n' "$key" "$val" >> "$tmp"
    else
      printf '%s=<未设置>\n' "$key" >> "$tmp"
    fi
  done
  print_credentials "$tmp" recall
  rm -f "$tmp"
  warn "以上为明文口令。请确认当前终端可信，且不要在共享会话中执行本命令。"
}

cmd_status() {
  need_docker
  log "仓库: $ROOT"
  log ""
  compose ps || true
  log ""
  log "健康检查:"
  if curl -sf --max-time 3 http://127.0.0.1:8080/health >/dev/null 2>&1; then
    ok "backend :8080/health"
  else
    warn "backend :8080/health 无响应"
  fi
  if curl -sf --max-time 3 http://127.0.0.1:80/ >/dev/null 2>&1 \
    || wget -qO- --timeout=3 http://127.0.0.1:80/ >/dev/null 2>&1; then
    ok "frontend :80"
  else
    warn "frontend :80 无响应"
  fi
}

cmd_logs() {
  local service="" tailn=100
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tail)
        tailn="${2:-}"
        if [[ -z "$tailn" || ! "$tailn" =~ ^[0-9]+$ ]]; then
          err "--tail 需要数字"
          exit 2
        fi
        shift 2
        ;;
      --tail=*)
        tailn="${1#--tail=}"
        if [[ ! "$tailn" =~ ^[0-9]+$ ]]; then
          err "--tail 需要数字"
          exit 2
        fi
        shift
        ;;
      -h|--help)
        log "用法: starbyte logs [服务] [--tail N]"
        exit 0
        ;;
      -*)
        err "未知参数: $1"
        exit 2
        ;;
      *)
        if [[ -n "$service" ]]; then
          err "多余参数: $1"
          exit 2
        fi
        service="$1"
        shift
        ;;
    esac
  done
  need_docker
  if [[ -n "$service" ]]; then
    compose logs --tail "$tailn" "$service"
  else
    compose logs --tail "$tailn"
  fi
}

cmd_restart() {
  local target="${1:-all}"
  case "$target" in
    all|postgres|redis|minio|backend|frontend) ;;
    *)
      err "未知服务: $target（postgres|redis|minio|backend|frontend|all）"
      exit 2
      ;;
  esac
  need_docker
  if [[ "$target" == "all" ]]; then
    log "重启全部服务..."
    compose restart
  else
    log "重启 $target ..."
    compose restart "$target"
  fi
}

cmd_rebuild() {
  local target="${1:-}"
  if [[ -z "$target" ]]; then
    err "用法: starbyte rebuild [backend|frontend|all]"
    exit 2
  fi
  local services=()
  case "$target" in
    backend|frontend) services=("$target") ;;
    all) services=(backend frontend) ;;
    *)
      err "rebuild 仅支持 backend|frontend|all（不含 MinIO/Postgres，避免镜像站强拉）"
      exit 2
      ;;
  esac
  need_docker
  log "构建: ${services[*]}"
  compose build "${services[@]}"
  log "重建（--no-deps --force-recreate）: ${services[*]}"
  compose up -d --no-deps --force-recreate "${services[@]}"
  log "完成。MinIO / Postgres / Redis 未被本命令拉取或重建。"
}

CRITICAL_KEYS=(
  POSTGRES_USER
  POSTGRES_PASSWORD
  POSTGRES_DB
  REDIS_PASSWORD
  MINIO_ROOT_USER
  MINIO_ROOT_PASSWORD
  JWT_SECRET
  SKIP_MIGRATION
  MIGRATION_FAIL_FATAL
  SKIP_BUCKET_CREATE
  CAS_ENABLED
  CAS_SERVER_URL
)

cmd_env_check() {
  local file="$ROOT/deploy/.env"
  local missing=0 empty=0
  log "检查 $file （只报键名，不打印值）"
  if [[ ! -f "$file" ]]; then
    warn "文件不存在。请先运行: starbyte init（由系统自动生成随机密钥）"
    return 1
  fi

  local key val
  for key in "${CRITICAL_KEYS[@]}"; do
    if ! env_has_key "$key"; then
      warn "缺少键: $key"
      missing=$((missing + 1))
      continue
    fi
    val="$(env_get "$key" || true)"
    if [[ -z "$val" ]]; then
      warn "键存在但值为空: $key"
      empty=$((empty + 1))
    else
      ok "已设置: $key"
    fi
  done

  # 密钥占位 / 弱值检查：只报键名，绝不回显实际内容
  local spec key mode param lower weak=0
  for spec in "${SECRET_SPECS[@]}"; do
    IFS=':' read -r key mode param <<<"$spec"
    env_has_key "$key" || continue
    val="$(env_get "$key" || true)"
    [[ -n "$val" ]] || continue
    lower="$(printf '%s' "$val" | tr '[:upper:]' '[:lower:]')"
    if [[ "$key" == "MINIO_ROOT_USER" ]]; then
      if [[ "$lower" == "minioadmin" ]]; then
        warn "MINIO_ROOT_USER 仍是示例值（值未打印）"
        weak=$((weak + 1))
      fi
      continue
    fi
    # b64 类：必须能被后端 base64 解码成 param 字节，否则后端会在用到时报错。
    # 只查长度会让「44 个字母数字」这种解不开的值蒙混过关，给出虚假的通过信号。
    if [[ "$mode" == "b64" ]]; then
      if ! b64_decodes_to "$val" "$param"; then
        warn "$key 不是合法的 Base64（解码后应为 ${param} 字节，值未打印）"
        weak=$((weak + 1))
      fi
      continue
    fi
    if [[ "${#val}" -lt 24 ]]; then
      warn "$key 长度不足 24，疑似占位或弱口令（值未打印）"
      weak=$((weak + 1))
      continue
    fi
    case "$lower" in
      *change-me*|*changeme*|*your-super-secret*|*example*|*minioadmin*|*starbyte123*|*placeholder*|*password*)
        warn "$key 命中示例 / 占位词表（值未打印）"
        weak=$((weak + 1))
        ;;
    esac
  done
  if [[ "$weak" -gt 0 ]]; then
    warn "共 ${weak} 个密钥疑似占位或强度不足。修复: starbyte init --force"
  fi

  if env_has_key MINIO_IMAGE; then
    ok "已设置: MINIO_IMAGE"
  else
    info "未设置 MINIO_IMAGE（compose 默认 minio/minio:latest）"
  fi

  if env_has_key CAS_AUTHSERVER_IP; then
    ok "已设置: CAS_AUTHSERVER_IP"
  else
    info "未设置 CAS_AUTHSERVER_IP（compose extra_hosts 默认值生效）"
  fi

  if [[ "$missing" -gt 0 || "$empty" -gt 0 || "$weak" -gt 0 ]]; then
    err "env-check 未通过（缺少 ${missing}，空值 ${empty}，密钥占位/弱值 ${weak}）"
    # 用 return 而非 exit：本函数会被 cmd_install / doctor 复用，
    # 直接 exit 会把容器的调用方也一起终止，且拿不到非零返回码。
    return 1
  fi
  log "env-check 通过"
  return 0
}

pick_backup_dir() {
  local dir
  if mkdir -p /var/backups/starbyte 2>/dev/null && [[ -w /var/backups/starbyte ]]; then
    dir=/var/backups/starbyte
  else
    dir="$ROOT/backups"
    mkdir -p "$dir"
  fi
  chmod 0700 "$dir" 2>/dev/null || true
  printf '%s' "$dir"
}

# 先建 0600 空文件再重定向，避免默认 umask 写出 0644
secure_create() {
  local path="$1" mode="${2:-600}"
  umask 077
  : > "$path"
  chmod "$mode" "$path"
}

cmd_backup() {
  local sub="${1:-create}"
  shift || true
  case "$sub" in
    help|-h|--help)
      cat <<'EOF'
starbyte backup create
starbyte backup list
starbyte backup preview <id>
starbyte backup restore <id> --confirm RESTORE
starbyte backup drill <id> --dbname <独立库> [--dsn DSN] [--password 跨主机密码] --confirm DRILL
starbyte backup emergency          # 主机明文 pg_dump（不加密、无预览）
EOF
      return 0
      ;;
    emergency)
      cmd_backup_emergency
      return
      ;;
  esac
  need_docker
  if ! docker exec starbyte-backend /app/starbyte-server backup "$sub" "$@"; then
    err "托管备份失败。backend 未运行时可用: starbyte backup emergency"
    exit 1
  fi
}

cmd_backup_emergency() {
  need_docker
  local dest stamp dump notes old_umask
  old_umask="$(umask)"
  umask 077
  dest="$(pick_backup_dir)"
  stamp="$(date +%Y%m%d-%H%M%S)"
  dump="$dest/postgres-${stamp}.sql"
  notes="$dest/README-${stamp}.txt"

  local user db
  user="$(env_get POSTGRES_USER 2>/dev/null || true)"
  db="$(env_get POSTGRES_DB 2>/dev/null || true)"
  user="${user:-starbyte}"
  db="${db:-starbyte}"

  log "Postgres dump → $dump"
  secure_create "$dump" 600
  if docker exec starbyte-postgres pg_dump -U "$user" "$db" > "$dump"; then
    chmod 600 "$dump"
    ok "已写入 $dump"
  else
    err "pg_dump 失败（容器 starbyte-postgres 是否在运行？）"
    rm -f "$dump"
    umask "$old_umask"
    exit 1
  fi

  secure_create "$notes" 600
  {
    echo "StarByte 备份说明  $stamp"
    echo "Postgres dump: $dump"
    echo ""
    echo "Named volumes（compose 项目目录一般为 deploy/，卷名带项目前缀）："
    docker volume ls --format '{{.Name}}' 2>/dev/null | grep -E 'postgres-data|redis-data|minio-data' || echo "(当前未见匹配卷名，compose 尚未创建)"
    echo ""
    echo "查看挂载点:"
    echo "  docker volume inspect <卷名>"
    echo ""
    echo "MinIO 数据在 minio-data 卷的 /data。桶名默认 starbyte。"
    echo "SKIP_BUCKET_CREATE=true 时恢复后需保证桶已存在。"
    echo ""
    echo "恢复 Postgres:"
    echo "  cat $dump | docker exec -i starbyte-postgres psql -U $user $db"
    echo ""
    echo "不要 docker compose down -v。"
  } > "$notes"
  chmod 600 "$notes"
  umask "$old_umask"

  log "说明: $notes"
  log "volume / MinIO 路径见该说明文件（未打包对象存储二进制，请另行复制卷）。"
}

# RFC1918 IPv4。IPv6 / 公网地址视为非内网（校园 CAS 不可走 2001:250:…）
is_private_ipv4() {
  local ip="$1"
  case "$ip" in
    10.*|192.168.*) return 0 ;;
    172.1[6-9].*|172.2[0-9].*|172.3[0-1].*) return 0 ;;
  esac
  return 1
}

# 尽力从运行中的 backend 取出 authserver 解析结果（不打印密钥）
backend_authserver_addrs() {
  local out=""
  out="$(docker exec starbyte-backend grep -E 'authserver\.smbu\.edu\.cn' /etc/hosts 2>/dev/null | awk '{print $1}' || true)"
  if [[ -z "$out" ]]; then
    out="$(docker exec starbyte-backend getent hosts authserver.smbu.edu.cn 2>/dev/null | awk '{print $1}' || true)"
  fi
  printf '%s' "$out"
}

listening_on() {
  local port="$1"
  if command -v ss >/dev/null 2>&1; then
    ss -lnt 2>/dev/null | grep -qE "[.:]${port}[[:space:]]"
    return
  fi
  if command -v netstat >/dev/null 2>&1; then
    netstat -lnt 2>/dev/null | grep -qE "[.:]${port}[[:space:]]"
    return
  fi
  return 1
}

cmd_doctor() {
  local issues=0
  log "StarByte doctor  仓库=$ROOT"
  log ""

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    ok "docker compose 可用"
  else
    warn "缺少 docker 或 compose 插件"
    issues=$((issues + 1))
  fi

  if [[ -f "$ROOT/deploy/.env" ]]; then
    ok "存在 deploy/.env"
    if [[ -f "$ROOT/$CRED_REL" ]]; then
      warn "$CRED_REL 仍存在（含明文初始口令）。抄录后请删除: shred -u $ROOT/$CRED_REL"
    fi
  else
    warn "缺少 deploy/.env。请运行: starbyte init（系统会自动生成随机密钥）"
    issues=$((issues + 1))
  fi

  log ""
  log "镜像站 / MinIO:"
  if [[ -f /etc/docker/daemon.json ]]; then
    if grep -qi 'registry-mirrors' /etc/docker/daemon.json 2>/dev/null; then
      info "daemon.json 含 registry-mirrors（请自测 pull；公开加速常 403）"
    else
      info "存在 /etc/docker/daemon.json，未见 registry-mirrors"
    fi
    if grep -qi 'xuanyuan' /etc/docker/daemon.json 2>/dev/null; then
      warn "daemon.json 含 xuanyuan：生产上曾对 minio/minio:RELEASE.* 返回 403"
      issues=$((issues + 1))
    fi
  else
    info "无 /etc/docker/daemon.json。校园网请自配已验证的 mirrors，或 docker save/load"
  fi

  if command -v docker >/dev/null 2>&1; then
    if docker image inspect minio/minio:latest >/dev/null 2>&1; then
      ok "本地已有 minio/minio:latest（compose 默认 + if_not_present 会复用）"
    else
      info "本地没有 minio/minio:latest；首次 up 需要能 pull 或先 load"
    fi
    if docker image inspect minio/minio:RELEASE.2024-08-17T01-16-21Z >/dev/null 2>&1; then
      info "本地仍有旧 RELEASE tag；现 compose 默认不再使用它"
    fi
  fi

  log ""
  log "SKIP_BUCKET_CREATE / 桶:"
  if [[ -f "$ROOT/deploy/.env" ]]; then
    local skip
    skip="$(env_get SKIP_BUCKET_CREATE 2>/dev/null || true)"
    if [[ "${skip,,}" == "true" ]]; then
      ok "SKIP_BUCKET_CREATE=true（镜像内 mc 为占位，不会自动建桶）"
      info "首次部署请在 MinIO 控制台手动创建桶 starbyte"
    else
      warn "SKIP_BUCKET_CREATE 不是 true：内网 stub mc 无法真正建桶"
      issues=$((issues + 1))
    fi
  fi

  log ""
  log "CAS 回调:"
  info "漏测无域名：用校园网 IP 打开站点，备案 http://<服务器IP>/api/v1/auth/cas/callback"
  info "CAS_SERVICE_URL / CAS_FRONTEND_URL 留空则按访问 Host 自动拼"
  if [[ -f "$ROOT/deploy/.env" ]]; then
    local cas_en
    cas_en="$(env_get CAS_ENABLED 2>/dev/null || true)"
    if [[ "${cas_en,,}" != "true" ]]; then
      warn "CAS_ENABLED 不是 true，登录页可能没有「学校统一认证」"
    else
      ok "CAS_ENABLED=true"
    fi
  fi
  if grep -q 'extra_hosts' "$ROOT/deploy/docker-compose.yml" \
    && grep -q 'authserver.smbu.edu.cn' "$ROOT/deploy/docker-compose.yml"; then
    ok "compose 已写入 authserver extra_hosts（CAS_AUTHSERVER_IP 默认 10.100.14.250）"
  else
    warn "compose 缺少 authserver extra_hosts：容器可能解析到 IPv6，CAS callback 超时/502"
    issues=$((issues + 1))
  fi
  if command -v docker >/dev/null 2>&1 \
    && docker inspect -f '{{.State.Status}}' starbyte-backend 2>/dev/null | grep -qx running; then
    local addr
    addr="$(backend_authserver_addrs | head -n1 || true)"
    if [[ -z "$addr" ]]; then
      info "backend 内未能解析 authserver.smbu.edu.cn（可选检查，可 recreate 后再看）"
    elif is_private_ipv4 "$addr"; then
      ok "backend 将 authserver 解析到内网 IPv4"
    else
      warn "backend 将 authserver 解析为非内网地址（常见为公网 IPv6）。CAS callback 会卡住/502；设 CAS_AUTHSERVER_IP 后 starbyte rebuild backend"
      issues=$((issues + 1))
    fi
  fi

  log ""
  log "端口 80:"
  if listening_on 80; then
    if command -v docker >/dev/null 2>&1 && docker inspect -f '{{.State.Status}}' starbyte-frontend 2>/dev/null | grep -qx running; then
      ok "80 已被 starbyte-frontend 占用（预期）"
    else
      warn "主机 80 已被占用，且未见运行中的 starbyte-frontend。停掉宝塔/nginx 或改映射后再 up"
      issues=$((issues + 1))
    fi
  else
    info "当前未见 80 监听；compose up 后 frontend 会映射 80"
  fi

  if command -v docker >/dev/null 2>&1 && docker inspect starbyte-backend >/dev/null 2>&1; then
    log ""
    log "运行中容器短检:"
    if curl -sf --max-time 3 http://127.0.0.1:8080/health >/dev/null 2>&1; then
      ok "backend :8080/health"
    else
      warn "backend 容器在，但 :8080/health 失败"
      issues=$((issues + 1))
    fi
  fi

  log ""
  if [[ "$issues" -gt 0 ]]; then
    warn "doctor 发现 ${issues} 项需处理"
    exit 1
  fi
  ok "doctor 未发现必须处理的问题"
}

# ═════════════════════════════════════════════════════════
# HTTPS 开关（审计项 S-03）：starbyte ssl
#
# 为什么做成子命令组、而不是 `ssl on | ssl off` 两个值：
#   - 真正决定成败的是「证书从哪来、和私钥配不配」，不是一个布尔量；
#   - 443 的 server 块一旦加载失败，nginx 进程起不来，会**连 HTTP 一起带走** ——
#     所以必须有一条和 enable 同等重要、且在故障中仍然能执行的回退路径（disable）。
#
# 启用状态的唯一事实来源：deploy/nginx/https.d/starbyte-https.conf 是否存在。
#   存在   → compose() 自动叠加 deploy/docker-compose.https.yml，443 块被加载；
#   不存在 → 目录里没有 *.conf，主配置末尾的通配 include 匹配不到文件且不报错，
#            部署保持纯 HTTP，与引入本机制之前完全一致。
# 一个文件同时充当「状态」与「开关」，好处是：状态可见、操作幂等、回滚零风险。
#
# 一期（学校提供 *.smbu.edu.cn 通配证书）只用到三条：
#   starbyte ssl enable --cert <crt> --key <key>
#   starbyte ssl status
#   starbyte ssl disable
# Let's Encrypt / DNS-01 在一期完全用不上，故刻意不实现 —— 需要时再加 acme.sh 钩子，
# 别为了「以后可能要用」现在就引入一条要每 90 天改一次 DNS TXT 的链路。
# ═════════════════════════════════════════════════════════

HTTPS_CONF_REL="deploy/nginx/https.d/starbyte-https.conf"
HTTPS_TEMPLATE_REL="deploy/nginx/starbyte-https.conf.template"
HTTPS_OVERRIDE_REL="deploy/docker-compose.https.yml"
CERTS_REL="deploy/certs"
CERT_NAME="starbyte"
CERT_WARN_DAYS=30   # 剩余天数低于此值：提醒续期
CERT_CRIT_DAYS=7    # 剩余天数低于此值：强提醒

SSL_CERT=""
SSL_KEY=""

https_enabled() { [[ -f "$ROOT/$HTTPS_CONF_REL" ]]; }
cert_path() { printf '%s/%s/%s.crt' "$ROOT" "$CERTS_REL" "$CERT_NAME"; }
key_path()  { printf '%s/%s/%s.key' "$ROOT" "$CERTS_REL" "$CERT_NAME"; }

ssl_usage() {
  cat <<'EOF'
HTTPS 管理（审计项 S-03）

用法:
  starbyte ssl status                     签发者 / 到期日 / 剩余天数 / 是否已启用
  starbyte ssl enable --cert <crt> --key <key> [--host <域名>]
                                          用现成证书启用 HTTPS（一期的主路径）
  starbyte ssl enable                     刷新模式：复用 deploy/certs 里已有的证书，
                                          用于应用升级后的仓库模板
  starbyte ssl verify [--cert <crt> --key <key>] [--host <域名>]
                                          只体检，不落地、不改运行状态
  starbyte ssl disable                    一键回退到纯 HTTP（逃生门）
  starbyte ssl selfsign --host <域名> [--days N] --yes
                                          自签证书，**仅供联调**，不要用于上线

说明:
  - 证书被复制到 deploy/certs/starbyte.crt(0644) 与 starbyte.key(0600)。
    复制而非软链：容器里的软链指向宿主路径会解析失败。
    该目录已被根 .gitignore 挡住（certs/ 与 *.key 两条），私钥不会进版本库。
  - 启用后 HTTP(80) **仍然可用**：那是证书配错时的逃生通道，故不做 80→443 强制跳转。
    想强制走 HTTPS 交给 HSTS 在浏览器侧完成。
  - HSTS 首次 max-age=300（5 分钟）。确认无混合内容后再逐步调大。
  - enable 会先建 frontend 镜像、再用一次性容器跑 `nginx -t` 预检；
    预检不通过就不碰正在运行的服务，并自动回滚。
  - disable 不删证书（那是学校签发的资产，删了要重新申请）。
EOF
}

need_openssl() {
  if ! command -v openssl >/dev/null 2>&1; then
    err "未找到 openssl —— ssl 子命令需要它来校验证书与私钥是否配对。"
    err "安装: apt-get install -y openssl   (Debian/Ubuntu)"
    exit 1
  fi
}

# 文件权限，GNU stat 与 BSD stat 都试一遍
file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || printf '?'
}

# 收紧私钥权限，并**校验结果**。在 chmod 语义不生效的文件系统上（NTFS / CIFS 挂载、
# 某些容器卷）chmod 会静默失败，私钥仍是全局可读 —— 这种失败不能当成没发生。
harden_key_perms() {
  local f="$1" m
  chmod 0600 "$f" 2>/dev/null || true
  m="$(file_mode "$f")"
  if [[ "$m" != "600" && "$m" != "400" ]]; then
    warn "私钥权限未能收紧到 600（当前 $m）—— 该文件系统可能不支持 Unix 权限位。"
    warn "  deploy/certs/ 所在卷的访问控制请自行确认，别把私钥暴露给其他账号。"
    return 1
  fi
  return 0
}

# 证书 / 私钥的公钥 SHA-256 指纹（用于判断配对）。失败返回空串，不返回非 0。
ssl_pubkey_hash_cert() {
  openssl x509 -in "$1" -noout -pubkey 2>/dev/null \
    | openssl pkey -pubin -outform DER 2>/dev/null \
    | openssl dgst -sha256 2>/dev/null | awk '{print $NF}' || true
}
ssl_pubkey_hash_key() {
  openssl pkey -in "$1" -pubout -outform DER 2>/dev/null \
    | openssl dgst -sha256 2>/dev/null | awk '{print $NF}' || true
}

# openssl 的日期串 → epoch。GNU date 与 BSD date 都试。
ssl_date_to_epoch() {
  local s="$1" e=""
  [[ -n "$s" ]] || { printf ''; return 0; }
  e="$(date -d "$s" +%s 2>/dev/null || true)"
  if [[ -z "$e" ]]; then
    e="$(date -j -f "%b %e %T %Y %Z" "$s" +%s 2>/dev/null || true)"
  fi
  printf '%s' "$e"
}

ssl_cert_days_left() {
  local crt="$1" end e now
  end="$(openssl x509 -in "$crt" -noout -enddate 2>/dev/null | cut -d= -f2- || true)"
  [[ -n "$end" ]] || { printf ''; return 0; }
  e="$(ssl_date_to_epoch "$end")"
  [[ -n "$e" ]] || { printf ''; return 0; }
  now="$(date +%s)"
  printf '%s' "$(( (e - now) / 86400 ))"
}

ssl_cert_sans() {
  local crt="$1" out=""
  out="$(openssl x509 -in "$crt" -noout -ext subjectAltName 2>/dev/null | sed '1d' || true)"
  if [[ -z "$out" ]]; then
    out="$(openssl x509 -in "$crt" -noout -text 2>/dev/null \
      | awk '/X509v3 Subject Alternative Name/{getline; print}' || true)"
  fi
  printf '%s' "$out" | tr ',' '\n' | sed -n 's/^[[:space:]]*DNS://p' | tr -d ' ' | tr '\n' ' '
}

# 证书是否覆盖主机名 $2。注意通配规则：*.a.cn 只覆盖一级子域，
# 既不匹配裸域 a.cn，也不匹配 x.y.a.cn。这条我踩过 —— 学校给的是
# *.smbu.edu.cn，所以入口必须是 starbyte.smbu.edu.cn 这类子域名。
ssl_host_covered() {
  local crt="$1" want="$2" san suffix prefix
  for san in $(ssl_cert_sans "$crt"); do
    [[ "$san" == "$want" ]] && return 0
    if [[ "$san" == \*.* ]]; then
      suffix="${san#\*.}"
      case "$want" in
        *."$suffix")
          prefix="${want%.$suffix}"
          [[ -n "$prefix" && "$prefix" != *.* ]] && return 0
          ;;
      esac
    fi
  done
  return 1
}

# 一份证书/私钥的体检报告。$1=crt $2=key $3=期望主机名(可空)
# 返回 0 = 可用于启用；返回 1 = 有致命问题，不应启用。
ssl_inspect_pair() {
  local crt="$1" key="$2" host="${3:-}" failed=0
  local subj iss end days sans nb now nb_epoch hc hk

  if ! openssl x509 -in "$crt" -noout >/dev/null 2>&1; then
    err "不是有效的 X.509 证书（openssl 解析失败）: $crt"
    err "  常见原因：给的是 PKCS#12(.pfx/.p12) 或只有中间证书链。要的是 PEM 格式证书。"
    return 1
  fi
  if ! openssl pkey -in "$key" -noout >/dev/null 2>&1; then
    err "不是有效的私钥（openssl 解析失败）: $key"
    err "  若私钥有口令，先解密：openssl pkey -in <key> -out starbyte.key"
    return 1
  fi

  hc="$(ssl_pubkey_hash_cert "$crt")"
  hk="$(ssl_pubkey_hash_key "$key")"
  if [[ -z "$hc" || -z "$hk" ]]; then
    warn "无法比对公钥指纹，跳过配对校验"
  elif [[ "$hc" != "$hk" ]]; then
    err "证书与私钥不配对（公钥指纹不一致）—— 这是最常见的部署事故"
    return 1
  else
    ok "证书与私钥配对"
  fi

  subj="$(openssl x509 -in "$crt" -noout -subject 2>/dev/null | sed 's/^subject=//' || true)"
  iss="$(openssl x509 -in "$crt" -noout -issuer 2>/dev/null | sed 's/^issuer=//' || true)"
  info "主体:   ${subj:-未知}"
  info "签发者: ${iss:-未知}"

  sans="$(ssl_cert_sans "$crt")"
  if [[ -n "$sans" ]]; then
    info "覆盖:   $sans"
  else
    warn "证书里没有 SAN（subjectAltName）—— 现代浏览器不再认 CN，会报域名不匹配"
  fi

  # 生效期
  now="$(date +%s)"
  nb="$(openssl x509 -in "$crt" -noout -startdate 2>/dev/null | cut -d= -f2- || true)"
  nb_epoch="$(ssl_date_to_epoch "$nb")"
  if [[ -n "$nb_epoch" && "$nb_epoch" -gt "$now" ]]; then
    err "证书尚未生效（notBefore=$nb）—— 多半是本机时间不对，先校时再启用"
    failed=1
  fi

  end="$(openssl x509 -in "$crt" -noout -enddate 2>/dev/null | cut -d= -f2- || true)"
  days="$(ssl_cert_days_left "$crt")"
  if [[ -n "$end" ]]; then
    if [[ -n "$days" ]]; then
      if [[ "$days" -lt 0 ]]; then
        err "证书已过期（$end），启用后浏览器会直接拦截"
        failed=1
      elif [[ "$days" -lt "$CERT_CRIT_DAYS" ]]; then
        err "证书 ${days} 天后过期（$end），请立即向学校信息化申请续期"
      elif [[ "$days" -lt "$CERT_WARN_DAYS" ]]; then
        warn "证书 ${days} 天后过期（$end），现在就该去申请续期了"
      else
        ok "有效期至 $end（剩余 ${days} 天）"
      fi
    else
      info "有效期至 $end（本机 date 解析不了这个格式，未算剩余天数）"
    fi
  else
    warn "读不到证书有效期"
  fi

  if [[ -n "$host" ]]; then
    if ssl_host_covered "$crt" "$host"; then
      ok "证书覆盖 $host"
    else
      warn "证书 SAN 里没有 $host —— 浏览器会报域名不匹配"
      warn "提醒：*.smbu.edu.cn 只覆盖一级子域，不覆盖裸域 smbu.edu.cn"
    fi
  fi

  [[ "$failed" -eq 0 ]]
}

# 解析 --cert/--key 到 SSL_CERT / SSL_KEY；两者都空则回落到 deploy/certs 现有证书。
ssl_resolve_pair() {
  local cert="$1" key="$2"
  if [[ -z "$cert" && -z "$key" ]]; then
    cert="$(cert_path)"
    key="$(key_path)"
    if [[ ! -f "$cert" || ! -f "$key" ]]; then
      err "未给 --cert/--key，且 deploy/certs 里没有可复用的 ${CERT_NAME}.crt / ${CERT_NAME}.key"
      err "用法: starbyte ssl enable --cert <crt> --key <key>"
      return 1
    fi
  elif [[ -z "$cert" || -z "$key" ]]; then
    err "--cert 与 --key 必须同时提供（只给一个无法部署）"
    return 1
  fi
  if [[ ! -f "$cert" ]]; then err "证书文件不存在: $cert"; return 1; fi
  if [[ ! -r "$cert" ]]; then err "证书文件不可读: $cert"; return 1; fi
  if [[ ! -f "$key" ]]; then err "私钥文件不存在: $key"; return 1; fi
  if [[ ! -r "$key" ]]; then err "私钥文件不可读（多为权限问题，试加 sudo）: $key"; return 1; fi
  SSL_CERT="$cert"
  SSL_KEY="$key"
}

# 回滚：移除 443 配置，并把本次写入的证书文件恢复/删除。$1=备份目录(可为空)
ssl_rollback() {
  local backup="$1" f
  rm -f "$ROOT/$HTTPS_CONF_REL"
  for f in "$(cert_path)" "$(key_path)"; do
    if [[ -n "$backup" && -f "$backup/$(basename "$f")" ]]; then
      mv -f "$backup/$(basename "$f")" "$f"
    else
      rm -f "$f"
    fi
  done
  [[ -n "$backup" && -d "$backup" ]] && rmdir "$backup" 2>/dev/null || true
  warn "已回滚：移除 443 配置，证书文件恢复原状"
}

# ── starbyte ssl status ──────────────────────────────────
cmd_ssl_status() {
  local crt key tpl cur rc=0 hp
  crt="$(cert_path)"
  key="$(key_path)"
  tpl="$ROOT/$HTTPS_TEMPLATE_REL"
  cur="$ROOT/$HTTPS_CONF_REL"
  hp="${STARBYTE_HTTPS_PORT:-443}"

  log "HTTPS 状态（审计项 S-03）"
  log ""
  if https_enabled; then
    ok "状态: 已启用"
    info "生效配置: docker-compose.yml + $(basename "$HTTPS_OVERRIDE_REL")"
    info "          （443 端口映射 + 证书/https.d 只读挂载）"
  else
    info "状态: 未启用（当前为纯 HTTP）"
    info "生效配置: 仅 docker-compose.yml"
  fi

  log ""
  if [[ -f "$crt" ]]; then
    info "证书: $CERTS_REL/${CERT_NAME}.crt   权限 $(file_mode "$crt")"
  else
    info "证书: $CERTS_REL/${CERT_NAME}.crt   (不存在)"
  fi
  if [[ -f "$key" ]]; then
    local kperm
    kperm="$(file_mode "$key")"
    info "私钥: $CERTS_REL/${CERT_NAME}.key   权限 $kperm"
    if [[ "$kperm" != "600" && "$kperm" != "400" ]]; then
      warn "私钥权限是 $kperm，建议 600（重跑 starbyte ssl enable 会自动收紧）"
    fi
  else
    info "私钥: $CERTS_REL/${CERT_NAME}.key   (不存在)"
  fi

  if [[ -f "$crt" && -f "$key" ]] && command -v openssl >/dev/null 2>&1; then
    log ""
    ssl_inspect_pair "$crt" "$key" "" || rc=1
  elif [[ -f "$crt" && ! -f "$key" ]]; then
    log ""
    warn "只有证书没有私钥 —— 无法部署。向学校要证书时要明确说「私钥 + 中间证书链」。"
  fi

  if [[ -f "$cur" && -f "$tpl" ]] && ! diff -q "$tpl" "$cur" >/dev/null 2>&1; then
    log ""
    warn "生效的 443 配置与仓库模板不一致（仓库升级过）。"
    warn "应用新模板: starbyte ssl enable   # 不带参数，复用 deploy/certs 现有证书"
  fi

  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    log ""
    log "frontend 容器:"
    compose ps frontend 2>/dev/null || info "compose ps 无输出"
  fi

  log ""
  if https_enabled; then
    if command -v curl >/dev/null 2>&1 \
      && curl -kfsS --max-time 5 "https://127.0.0.1:${hp}/" -o /dev/null 2>/dev/null; then
      ok "https://127.0.0.1:${hp}/ 可达"
    elif command -v curl >/dev/null 2>&1; then
      warn "https://127.0.0.1:${hp}/ 无响应（查 starbyte logs frontend）"
    fi
  fi
  if command -v curl >/dev/null 2>&1 \
    && curl -sf --max-time 5 "http://127.0.0.1:${STARBYTE_HTTP_PORT:-80}/" -o /dev/null 2>/dev/null; then
    ok "http://127.0.0.1:${STARBYTE_HTTP_PORT:-80}/ 可达（逃生通道在位）"
  fi

  if ! https_enabled && [[ -f "$crt" && -f "$key" ]]; then
    log ""
    info "证书已就位但未启用。启用: starbyte ssl enable"
  fi

  return "$rc"
}

# ── starbyte ssl verify ──────────────────────────────────
cmd_ssl_verify() {
  local cert="" key="" host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cert)
        [[ $# -ge 2 && -n "${2:-}" ]] || { err "--cert 需要一个路径"; exit 2; }
        cert="$2"; shift 2 ;;
      --cert=*) cert="${1#--cert=}"; shift ;;
      --key)
        [[ $# -ge 2 && -n "${2:-}" ]] || { err "--key 需要一个路径"; exit 2; }
        key="$2"; shift 2 ;;
      --key=*) key="${1#--key=}"; shift ;;
      --host)
        [[ $# -ge 2 && -n "${2:-}" ]] || { err "--host 需要一个域名"; exit 2; }
        host="$2"; shift 2 ;;
      --host=*) host="${1#--host=}"; shift ;;
      -h|--help) ssl_usage; exit 0 ;;
      *) err "未知参数: $1"; exit 2 ;;
    esac
  done
  need_openssl
  ssl_resolve_pair "$cert" "$key" || exit 2
  log "证书体检（不改动任何状态）: $SSL_CERT"
  log ""
  if ssl_inspect_pair "$SSL_CERT" "$SSL_KEY" "$host"; then
    log ""
    ok "结论：可用于启用 HTTPS"
  else
    log ""
    err "结论：存在致命问题，不要启用"
    exit 1
  fi
}

# ── starbyte ssl enable ──────────────────────────────────
cmd_ssl_enable() {
  local cert="" key="" host=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --cert)
        [[ $# -ge 2 && -n "${2:-}" ]] || { err "--cert 需要一个路径"; exit 2; }
        cert="$2"; shift 2 ;;
      --cert=*) cert="${1#--cert=}"; shift ;;
      --key)
        [[ $# -ge 2 && -n "${2:-}" ]] || { err "--key 需要一个路径"; exit 2; }
        key="$2"; shift 2 ;;
      --key=*) key="${1#--key=}"; shift ;;
      --host)
        [[ $# -ge 2 && -n "${2:-}" ]] || { err "--host 需要一个域名"; exit 2; }
        host="$2"; shift 2 ;;
      --host=*) host="${1#--host=}"; shift ;;
      -h|--help) ssl_usage; exit 0 ;;
      *) err "未知参数: $1（见 starbyte ssl help）"; exit 2 ;;
    esac
  done

  need_openssl
  need_docker
  ssl_resolve_pair "$cert" "$key" || exit 2

  local src_crt="$SSL_CERT" src_key="$SSL_KEY"
  local dst_crt dst_key
  dst_crt="$(cert_path)"
  dst_key="$(key_path)"

  if [[ ! -f "$ROOT/$HTTPS_TEMPLATE_REL" ]]; then
    err "缺少模板 $HTTPS_TEMPLATE_REL —— 仓库不完整，先 git pull"
    exit 1
  fi

  log "HTTPS 启用检查"
  log ""
  if ! ssl_inspect_pair "$src_crt" "$src_key" "$host"; then
    log ""
    err "体检未通过，未做任何改动。"
    exit 1
  fi
  log ""

  # 1) 落地证书。只在确实要覆盖已有文件时备份，失败可原样退回。
  mkdir -p "$ROOT/$CERTS_REL"
  chmod 700 "$ROOT/$CERTS_REL" 2>/dev/null || true
  local backup=""
  if [[ ( "$src_crt" != "$dst_crt" && -f "$dst_crt" ) || ( "$src_key" != "$dst_key" && -f "$dst_key" ) ]]; then
    backup="$ROOT/$CERTS_REL/.backup-$(date +%Y%m%d%H%M%S)"
    mkdir -p "$backup"
    [[ -f "$dst_crt" ]] && cp -p "$dst_crt" "$backup/"
    [[ -f "$dst_key" ]] && cp -p "$dst_key" "$backup/"
    info "已备份原有证书到 $CERTS_REL/$(basename "$backup")"
  fi

  if [[ "$src_crt" != "$dst_crt" ]]; then
    install -m 0644 "$src_crt" "$dst_crt"
  else
    chmod 0644 "$dst_crt" 2>/dev/null || true
  fi
  if [[ "$src_key" != "$dst_key" ]]; then
    install -m 0600 "$src_key" "$dst_key"
  fi
  harden_key_perms "$dst_key" || true
  ok "证书已就位 $CERTS_REL/${CERT_NAME}.crt(0644) / ${CERT_NAME}.key(600)"
  info "复制而非软链：容器里的软链会指向宿主路径而解析失败"

  # 2) 生成 443 配置 —— 这一步完成，启用状态即成立
  mkdir -p "$ROOT/deploy/nginx/https.d"
  install -m 0644 "$ROOT/$HTTPS_TEMPLATE_REL" "$ROOT/$HTTPS_CONF_REL"
  ok "已写入 $HTTPS_CONF_REL（存在即启用）"

  # 3) 构建 frontend：新的 nginx.conf 通配 include 与 Dockerfile 预建目录在镜像里
  log ""
  log "构建 frontend 镜像（纳入 nginx.conf 的通配 include 与 https.d 目录）..."
  if ! compose build frontend; then
    ssl_rollback "$backup"
    err "frontend 构建失败，已回滚，服务保持原状。"
    exit 1
  fi

  # 4) 预检：用一次性容器跑 nginx -t。不通过就绝不碰正在运行的容器。
  log ""
  log "预检：一次性容器执行 nginx -t ..."
  if ! compose run --rm --no-deps -T --entrypoint nginx frontend -t; then
    ssl_rollback "$backup"
    err "nginx 配置校验未通过，已回滚，服务保持原状。"
    exit 1
  fi
  ok "nginx -t 通过"

  # 5) 重建 frontend
  log ""
  log "重建 frontend ..."
  compose up -d --no-deps --force-recreate frontend

  # 6) 复核
  log ""
  log "启用完成，复核:"
  local hp="${STARBYTE_HTTPS_PORT:-443}" http_port="${STARBYTE_HTTP_PORT:-80}"
  if command -v curl >/dev/null 2>&1; then
    if curl -kfsS --max-time 5 "https://127.0.0.1:${hp}/" -o /dev/null 2>/dev/null; then
      ok "https://127.0.0.1:${hp}/ 已响应"
    else
      warn "https://127.0.0.1:${hp}/ 暂无响应 —— 查 starbyte logs frontend"
    fi
    if curl -sf --max-time 5 "http://127.0.0.1:${http_port}/" -o /dev/null 2>/dev/null; then
      ok "http://127.0.0.1:${http_port}/ 仍然可用（逃生通道在位）"
    else
      warn "HTTP 入口无响应 —— 逃生通道可能在校园网侧被单独关闭，检查一下"
    fi
  fi

  log ""
  log "后续必做:"
  info "1. 把 CAS 回调地址改成 https://<你的域名>/api/v1/auth/cas/callback 并向学校备案"
  info "2. 确认防火墙 80 与 443 都放行（80 必须留着，那是逃生通道）"
  info "3. 观察几天无混合内容报错后，把模板里的 HSTS max-age 从 300 逐步调大，"
  info "   改完运行 starbyte ssl enable 刷新"
  info "4. 到期前 30 天 starbyte ssl status 会提醒；换新证书后重跑本命令即可"
  if [[ "$host" == "localhost" || -z "$host" ]]; then
    log ""
    info "建议：下次带上 --host <域名>，体检会顺便校验证书是否覆盖该域名。"
  fi
}

# ── starbyte ssl disable ─────────────────────────────────
cmd_ssl_disable() {
  if [[ $# -gt 0 ]]; then
    case "$1" in
      -h|--help) ssl_usage; exit 0 ;;
      *) err "ssl disable 不接受参数"; exit 2 ;;
    esac
  fi
  if ! https_enabled; then
    info "当前未启用 HTTPS（纯 HTTP），无需操作。"
    exit 0
  fi
  need_docker
  log "停用 HTTPS：移除 443 配置并重建 frontend ..."
  rm -f "$ROOT/$HTTPS_CONF_REL"
  ok "已移除 $HTTPS_CONF_REL"

  if ! compose up -d --no-deps --force-recreate frontend; then
    err "frontend 重建失败。443 配置已移除，可手动重试："
    err "  docker compose -f deploy/docker-compose.yml up -d --no-deps --force-recreate frontend"
    exit 1
  fi

  local http_port="${STARBYTE_HTTP_PORT:-80}"
  log ""
  warn "证书文件仍保留在 $CERTS_REL —— 不删，那是学校签发的资产"
  warn "浏览器侧已下发的 HSTS 会在 max-age(默认 300 秒) 后失效，这几分钟内可能仍强制 HTTPS"
  log ""
  if command -v curl >/dev/null 2>&1; then
    if curl -sf --max-time 5 "http://127.0.0.1:${http_port}/" -o /dev/null 2>/dev/null; then
      ok "http://127.0.0.1:${http_port}/ 已恢复"
    else
      warn "HTTP 入口暂无响应 —— 查 starbyte logs frontend"
    fi
  fi
  log ""
  info "注意：CAS 的回调地址若已改成 https，请同步向学校改回 http，否则登录会失败。"
}

# ── starbyte ssl selfsign ────────────────────────────────
# 自签证书的唯一正当用途：在学校证书到位之前，先把整条 HTTPS 链路联调通
# （挂载、include、nginx -t、443 可达）。**不要拿它上线** ——
# 每个同学首次访问都会看到红色告警页，微信里点开还会被拦。
cmd_ssl_selfsign() {
  local host="localhost" days=365 yes=0 cfg
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --host)
        [[ $# -ge 2 && -n "${2:-}" ]] || { err "--host 需要一个域名"; exit 2; }
        host="$2"; shift 2 ;;
      --host=*) host="${1#--host=}"; shift ;;
      --days)
        [[ $# -ge 2 && -n "${2:-}" ]] || { err "--days 需要一个数字"; exit 2; }
        days="$2"; shift 2 ;;
      --days=*) days="${1#--days=}"; shift ;;
      --yes|-y) yes=1; shift ;;
      -h|--help) ssl_usage; exit 0 ;;
      *) err "未知参数: $1"; exit 2 ;;
    esac
  done
  [[ "$days" =~ ^[0-9]+$ ]] || { err "--days 需要数字"; exit 2; }
  need_openssl

  if [[ "$yes" -ne 1 ]]; then
    err "自签证书仅供联调，浏览器会报不受信任 —— 不要用于正式上线。"
    err "确认要继续请显式加 --yes："
    err "  starbyte ssl selfsign --host $host --yes"
    exit 2
  fi

  mkdir -p "$ROOT/$CERTS_REL"
  chmod 700 "$ROOT/$CERTS_REL" 2>/dev/null || true
  local crt key_
  crt="$(cert_path)"
  key_="$(key_path)"

  # 优先用 -addext（openssl >= 1.1.1）；不支持则退回临时配置文件，
  # 否则证里没有 SAN，现代浏览器一律不认。
  if ! openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days "$days" \
        -keyout "$key_" -out "$crt" -subj "/CN=${host}" \
        -addext "subjectAltName=DNS:${host}" >/dev/null 2>&1; then
    warn "openssl 不支持 -addext，改用临时配置文件写入 SAN"
    cfg="$(mktemp)"
    cat > "$cfg" <<EOF
[req]
distinguished_name = dn
x509_extensions = v3
prompt = no
[dn]
CN = ${host}
[v3]
subjectAltName = DNS:${host}
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
EOF
    if ! openssl req -x509 -newkey rsa:2048 -nodes -sha256 -days "$days" \
          -keyout "$key_" -out "$crt" -config "$cfg" >/dev/null 2>&1; then
      rm -f "$cfg"
      err "自签证书生成失败（openssl 报错被静默，可去掉 >/dev/null 手动重跑看详情）"
      exit 1
    fi
    rm -f "$cfg"
  fi

  harden_key_perms "$key_" || true
  chmod 0644 "$crt" 2>/dev/null || true
  ok "自签证书已生成: $CERTS_REL/${CERT_NAME}.crt（CN=$host，${days} 天）"
  warn "这是**测试用**证书，浏览器不受信任。正式上线请换成学校签发的："
  warn "  starbyte ssl enable --cert <学校给的.crt> --key <学校给的.key>"
  log ""
  log "接着启用（复用刚生成的证书）:"
  log "  starbyte ssl enable"
}

# ── starbyte ssl ─────────────────────────────────────────
cmd_ssl() {
  local sub="${1:-help}"
  [[ $# -gt 0 ]] && shift || true
  case "$sub" in
    status|st) cmd_ssl_status "$@" ;;
    enable|on) cmd_ssl_enable "$@" ;;
    disable|off) cmd_ssl_disable "$@" ;;
    verify|check) cmd_ssl_verify "$@" ;;
    selfsign) cmd_ssl_selfsign "$@" ;;
    help|-h|--help) ssl_usage ;;
    *)
      err "未知 ssl 子命令: $sub"
      ssl_usage >&2
      exit 2
      ;;
  esac
}

cmd_install() {
  local dest="/usr/local/bin/starbyte"
  local src
  src="$(resolve_script_path)"
  init_root

  if [[ "$(id -u)" -ne 0 ]]; then
    err "install 需要 root：sudo bash deploy/cli/starbyte install"
    exit 1
  fi

  install -m 0755 "$src" "$dest"
  ln -sfn "$dest" /usr/local/bin/sb
  printf 'STARBYTE_HOME=%s\n' "$ROOT" > "$CONF_FILE"
  chmod 0644 "$CONF_FILE"
  log "已安装: $dest"
  log "软链:   /usr/local/bin/sb -> $dest"
  log "配置:   $CONF_FILE  (STARBYTE_HOME=$ROOT)"

  # 首次安装：配置不存在就由系统自动生成随机密钥，并把口令当场告知。
  # 已存在则不动（不覆盖既有部署的密钥），只提示查看方式。
  if [[ ! -f "$ROOT/$ENV_REL" ]]; then
    log ""
    log "未发现 $ENV_REL，正在自动生成随机密钥 ..."
    cmd_init
  else
    log ""
    log "已存在 $ENV_REL，未改动密钥。"
    log "  查看初始口令: starbyte credentials"
    log "  重新生成密钥: starbyte init --force"
  fi

  log ""
  log "试运行: starbyte status"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help|-h|--help) usage ;;
    version|-v|--version) log "starbyte $VERSION" ;;
    install) cmd_install "$@" ;;
    init) init_root; cmd_init "$@" ;;
    credentials) init_root; cmd_credentials "$@" ;;
    ssl) init_root; cmd_ssl "$@" ;;
    status|logs|restart|rebuild|env-check|backup|doctor)
      init_root
      case "$cmd" in
        status) cmd_status "$@" ;;
        logs) cmd_logs "$@" ;;
        restart) cmd_restart "$@" ;;
        rebuild) cmd_rebuild "$@" ;;
        # 显式透传返回码，让 `starbyte env-check && docker compose up` 真正短路
        env-check) cmd_env_check "$@"; exit $? ;;
        backup) cmd_backup "$@" ;;
        doctor) cmd_doctor "$@" ;;
      esac
      ;;
    *)
      err "未知命令: $cmd"
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
