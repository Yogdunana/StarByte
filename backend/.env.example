# StarByte Backend Environment Variables
# Copy this file to .env and adjust values as needed.
# Environment variables override YAML config values (highest priority).
#
# Loading order:
#   1. configs/config.yaml (base)
#   2. configs/config.{APP_ENV}.yaml (environment override)
#   3. Environment variables (this file)

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# APP_ENV selects the environment: dev, test, or prod
APP_ENV=dev
# CONFIG_PATH overrides the base config file path (default: configs/config.yaml)
# CONFIG_PATH=configs/config.yaml

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
SERVER_PORT=8080
# SERVER_MODE: debug, release, or test
SERVER_MODE=debug

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=starbyte
DB_PASSWORD=starbyte
DB_NAME=starbyte
DB_SSLMODE=disable
# DB_MAX_OPEN=100
# DB_MAX_IDLE=10

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------------------
# JWT (IMPORTANT: change the secret in production!)
# ---------------------------------------------------------------------------
JWT_SECRET=your-super-secret-key-change-in-production
# JWT_ACCESS_TOKEN_EXP=3600   (seconds, default 7200)
# JWT_REFRESH_TOKEN_EXP=604800 (seconds, default 604800)

# ---------------------------------------------------------------------------
# MinIO (Object Storage)
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=starbyte
# MINIO_USE_SSL=false

# ---------------------------------------------------------------------------
# Email / SMTP (optional)
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=your-password
# SMTP_FROM=noreply@example.com

# ---------------------------------------------------------------------------
# CORS (optional overrides)
# ---------------------------------------------------------------------------
# CORS_ALLOWED_ORIGINS=https://a.com,https://b.com
# CORS_ALLOWED_METHODS=GET,POST,PUT
# CORS_ALLOWED_HEADERS=Content-Type,Authorization
# CORS_EXPOSE_HEADERS=X-Request-Id,X-Custom-Header
# CORS_ALLOW_CREDENTIALS=true

# ---------------------------------------------------------------------------
# 学校 CAS（金智 IDS / authserver.smbu.edu.cn）
# 漏测先用校园网 IP：CAS_SERVICE_URL / CAS_FRONTEND_URL 留空，
# 系统用当前访问地址拼 http://<IP>/api/v1/auth/cas/callback
# 有域名后再写成 https://starbyte.smbu.edu.cn/...
# ---------------------------------------------------------------------------
# CAS_ENABLED=true
# CAS_SERVER_URL=https://authserver.smbu.edu.cn/authserver
# CAS_SERVICE_URL=
# CAS_FRONTEND_URL=
# CAS_ALLOW_AUTO_PROVISION=true
# CAS_DEFAULT_ROLE=member

# ---------------------------------------------------------------------------
# Google Calendar one-way pull (optional). Never commit real secrets.
# Redirect URI must match the Google Cloud OAuth client (API callback or frontend).
# ---------------------------------------------------------------------------
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8080/api/v1/schedules/google/callback

# ---------------------------------------------------------------------------
# Logger (optional overrides)
# ---------------------------------------------------------------------------
# LOG_LEVEL=info      (debug, info, warn, error)
# LOG_FORMAT=json     (json or console)
